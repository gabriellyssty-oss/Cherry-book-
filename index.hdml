<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cherry-books | Modern Online Bookstore</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .cherry-gradient { background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); }
  </style>
</head>
<body class="bg-gray-50 text-gray-900">

  <!-- Top Promo Banner -->
  <div class="cherry-gradient text-white text-xs font-semibold py-2 px-4 text-center tracking-wide">
    🍒 FLASH SALE: UP TO 40% OFF BESTSELLING MODERN FICTION + FREE SHIPPING OVER $35!
  </div>

  <!-- Navbar -->
  <header class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight text-rose-600">
        <span>🍒</span>
        <span>Cherry-books</span>
      </a>

      <!-- Search Bar -->
      <div class="flex-1 max-w-xl hidden sm:block">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput"
            onkeyup="filterBooks()"
            placeholder="Search titles, authors, genres..." 
            class="w-full bg-gray-100 border border-transparent focus:border-rose-500 focus:bg-white rounded-full py-2 pl-4 pr-10 text-sm outline-none transition"
          />
          <span class="absolute right-3.5 top-2.5 text-gray-400">🔍</span>
        </div>
      </div>

      <!-- Cart Button -->
      <button onclick="toggleCart()" class="relative flex items-center gap-2 bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold px-4 py-2 rounded-full transition">
        <span>🛒</span>
        <span class="hidden md:inline text-sm">Bag</span>
        <span id="cartCount" class="bg-rose-600 text-white text-xs font-bold px-2 py-0.5 rounded-full">0</span>
      </button>
    </div>

    <!-- Mobile Search -->
    <div class="sm:hidden px-4 pb-3">
      <input 
        type="text" 
        id="mobileSearchInput"
        onkeyup="filterBooks(true)"
        placeholder="Search books or authors..." 
        class="w-full bg-gray-100 rounded-full py-2 px-4 text-sm outline-none"
      />
    </div>
  </header>

  <!-- Hero Section -->
  <section class="bg-rose-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl space-y-4 text-center md:text-left">
        <span class="inline-block bg-rose-600/30 border border-rose-500/40 text-rose-200 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">
          New Arrivals 2026
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold leading-tight">
          Trending Stories, <span class="text-rose-400">Unbeatable Deals.</span>
        </h1>
        <p class="text-rose-100/80 text-sm sm:text-base">
          Discover viral BookTok hits, contemporary romance, dark academia, and modern thrillers delivered straight to your door.
        </p>
        <div class="pt-2 flex flex-wrap gap-3 justify-center md:justify-start">
          <a href="#catalog" class="bg-rose-600 hover:bg-rose-500 text-white font-bold px-6 py-3 rounded-full text-sm transition shadow-lg">
            Shop Trending
          </a>
          <button onclick="setCategory('Bestsellers')" class="bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-full text-sm transition">
            Daily Flash Deals
          </button>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 max-w-sm">
        <img src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=300&q=80" alt="Book 1" class="rounded-xl shadow-2xl transform -rotate-3 hover:rotate-0 transition duration-300 object-cover h-44 w-full">
        <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=300&q=80" alt="Book 2" class="rounded-xl shadow-2xl transform translate-y-3 hover:translate-y-0 transition duration-300 object-cover h-44 w-full">
        <img src="https://images.unsplash.com/photo-1589829085413-56de8ae18c73?auto=format&fit=crop&w=300&q=80" alt="Book 3" class="rounded-xl shadow-2xl transform rotate-3 hover:rotate-0 transition duration-300 object-cover h-44 w-full">
      </div>
    </div>
  </section>

  <!-- Categories Bar -->
  <section id="catalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar" id="categoryButtons">
      <button onclick="setCategory('All')" class="cat-btn active bg-rose-600 text-white px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap">All Books</button>
      <button onclick="setCategory('Romance')" class="cat-btn bg-white border border-gray-200 hover:border-rose-400 text-gray-700 px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap">Romance</button>
      <button onclick="setCategory('Thriller')" class="cat-btn bg-white border border-gray-200 hover:border-rose-400 text-gray-700 px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap">Thriller & Mystery</button>
      <button onclick="setCategory('Fantasy')" class="cat-btn bg-white border border-gray-200 hover:border-rose-400 text-gray-700 px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap">Fantasy</button>
      <button onclick="setCategory('Sci-Fi')" class="cat-btn bg-white border border-gray-200 hover:border-rose-400 text-gray-700 px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap">Sci-Fi</button>
      <button onclick="setCategory('Bestsellers')" class="cat-btn bg-white border border-gray-200 hover:border-rose-400 text-gray-700 px-4 py-2 rounded-full text-sm font-semibold whitespace-nowrap">🔥 Bestsellers</button>
    </div>
  </section>

  <!-- Product Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div id="bookGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      <!-- Books injected via JS -->
    </div>
  </main>

  <!-- Cart Drawer -->
  <div id="cartDrawer" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-xs" onclick="toggleCart()"></div>
    <div class="absolute right-0 top-0 h-full w-full max-w-md bg-white shadow-2xl flex flex-col justify-between p-6">
      <div>
        <div class="flex items-center justify-between border-b pb-4">
          <h2 class="text-lg font-bold">Your Cherry Bag 🍒</h2>
          <button onclick="toggleCart()" class="text-gray-400 hover:text-gray-700 text-xl font-bold">✕</button>
        </div>
        <div id="cartItems" class="mt-4 space-y-4 max-h-[60vh] overflow-y-auto">
          <p class="text-gray-400 text-sm text-center py-8">Your bag is empty. Add some books!</p>
        </div>
      </div>

      <div class="border-t pt-4 space-y-4">
        <div class="flex justify-between text-base font-bold">
          <span>Subtotal</span>
          <span id="cartTotal">$0.00</span>
        </div>
        <button onclick="checkout()" class="w-full cherry-gradient text-white font-bold py-3.5 rounded-full hover:opacity-95 transition shadow-md">
          Proceed to Checkout
        </button>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-white border-t border-gray-200 mt-16 py-10 text-center text-sm text-gray-500">
    <p class="font-bold text-rose-600 text-base mb-1">🍒 Cherry-books</p>
    <p>© 2026 Cherry-books Online Marketplace. All rights reserved.</p>
  </footer>

  <script>
    const books = [
      { id: 1, title: "Midnight in Crimson", author: "Elena Vance", category: "Romance", price: 12.99, oldPrice: 19.99, discount: "-35%", bestseller: true, img: "https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=400&q=80" },
      { id: 2, title: "The Glass Alibi", author: "Marcus Reid", category: "Thriller", price: 14.50, oldPrice: 22.00, discount: "-34%", bestseller: true, img: "https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=400&q=80" },
      { id: 3, title: "Crown of Starlight", author: "Aria Sterling", category: "Fantasy", price: 16.90, oldPrice: 24.99, discount: "-32%", bestseller: true, img: "https://images.unsplash.com/photo-1589829085413-56de8ae18c73?auto=format&fit=crop&w=400&q=80" },
      { id: 4, title: "Neon Horizon", author: "K. J. Mercer", category: "Sci-Fi", price: 11.99, oldPrice: 17.99, discount: "-33%", bestseller: false, img: "https://images.unsplash.com/photo-1532012197267-da84d127e765?auto=format&fit=crop&w=400&q=80" },
      { id: 5, title: "Letters We Never Sent", author: "Clara Hayes", category: "Romance", price: 10.99, oldPrice: 16.50, discount: "-33%", bestseller: true, img: "https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=400&q=80" },
      { id: 6, title: "Silent Echoes", author: "Julian Cross", category: "Thriller", price: 13.25, oldPrice: 18.99, discount: "-30%", bestseller: false, img: "https://images.unsplash.com/photo-1495446815901-a7297e633e8d?auto=format&fit=crop&w=400&q=80" },
      { id: 7, title: "Ashes & Ivy", author: "Sienna Thorne", category: "Fantasy", price: 15.40, oldPrice: 21.99, discount: "-30%", bestseller: false, img: "https://images.unsplash.com/photo-1519682337058-a94d519337bc?auto=format&fit=crop&w=400&q=80" },
      { id: 8, title: "Orbit Zero", author: "Devon Brooks", category: "Sci-Fi", price: 12.49, oldPrice: 18.00, discount: "-31%", bestseller: true, img: "https://images.unsplash.com/photo-1476275466078-4007374efbbe?auto=format&fit=crop&w=400&q=80" }
    ];

    let currentCategory = 'All';
    let cart = [];

    function renderBooks(list) {
      const grid = document.getElementById('bookGrid');
      grid.innerHTML = list.map(book => `
        <div class="bg-white rounded-2xl border border-gray-100 shadow-xs hover:shadow-md transition overflow-hidden flex flex-col justify-between group">
          <div>
            <div class="relative aspect-3/4 bg-gray-100 overflow-hidden">
              <img src="${book.img}" alt="${book.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-rose-600 text-white text-xs font-extrabold px-2 py-1 rounded-md">
                ${book.discount}
              </span>
            </div>
            <div class="p-3.5">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-rose-500">${book.category}</p>
              <h3 class="font-bold text-gray-900 text-sm sm:text-base line-clamp-1 mt-0.5">${book.title}</h3>
              <p class="text-xs text-gray-500 mt-0.5">${book.author}</p>
            </div>
          </div>
          <div class="px-3.5 pb-3.5 pt-1 flex items-center justify-between">
            <div>
              <span class="text-base sm:text-lg font-extrabold text-rose-600">$${book.price.toFixed(2)}</span>
              <span class="text-xs text-gray-400 line-through ml-1">$${book.oldPrice.toFixed(2)}</span>
            </div>
            <button onclick="addToCart(${book.id})" class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-3 py-2 rounded-full transition">
              + Add
            </button>
          </div>
        </div>
      `).join('');
    }

    function setCategory(cat) {
      currentCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(btn => {
        btn.classList.remove('bg-rose-600', 'text-white');
        btn.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        if (btn.textContent.includes(cat) || (cat === 'All' && btn.textContent === 'All Books')) {
          btn.classList.add('bg-rose-600', 'text-white');
          btn.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        }
      });
      filterBooks();
    }

    function filterBooks(isMobile = false) {
      const query = (isMobile ? document.getElementById('mobileSearchInput').value : document.getElementById('searchInput').value).toLowerCase();
      const filtered = books.filter(b => {
        const matchesCat = currentCategory === 'All' || (currentCategory === 'Bestsellers' ? b.bestseller : b.category === currentCategory);
        const matchesSearch = b.title.toLowerCase().includes(query) || b.author.toLowerCase().includes(query);
        return matchesCat && matchesSearch;
      });
      renderBooks(filtered);
    }

    function addToCart(id) {
      const book = books.find(b => b.id === id);
      const existing = cart.find(item => item.id === id);
      if (existing) {
        existing.qty++;
      } else {
        cart.push({ ...book, qty: 1 });
      }
      updateCartUI();
    }

    function removeFromCart(id) {
      cart = cart.filter(item => item.id !== id);
      updateCartUI();
    }

    function updateCartUI() {
      const count = cart.reduce((acc, item) => acc + item.qty, 0);
      const total = cart.reduce((acc, item) => acc + item.price * item.qty, 0);
      document.getElementById('cartCount').textContent = count;
      document.getElementById('cartTotal').textContent = `$${total.toFixed(2)}`;

      const container = document.getElementById('cartItems');
      if (cart.length === 0) {
        container.innerHTML = `<p class="text-gray-400 text-sm text-center py-8">Your bag is empty. Add some books!</p>`;
        return;
      }

      container.innerHTML = cart.map(item => `
        <div class="flex items-center justify-between gap-3 border-b pb-3">
          <img src="${item.img}" class="w-12 h-16 object-cover rounded-md" />
          <div class="flex-1">
            <h4 class="text-sm font-bold line-clamp-1">${item.title}</h4>
            <p class="text-xs text-gray-500">$${item.price.toFixed(2)} × ${item.qty}</p>
          </div>
          <button onclick="removeFromCart(${item.id})" class="text-xs text-rose-600 font-semibold hover:underline">Remove</button>
        </div>
      `).join('');
    }

    function toggleCart() {
      document.getElementById('cartDrawer').classList.toggle('hidden');
    }

    function checkout() {
      if (cart.length === 0) return alert("Your bag is empty!");
      alert("Thank you for shopping at Cherry-books! Your order is being processed.");
      cart = [];
      updateCartUI();
      toggleCart();
    }

    renderBooks(books);
  </script>
</body>
</html>
